# ==============================================================================
# DeployFlow (Mini Vercel) — Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your backend or set these variables in Render / Cloud dashboard.
# NEVER commit your actual .env file with secrets into version control.

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# GitHub Repository Configuration (Required for CI/CD tracking and workflow triggering)
# Example: If your repository is https://github.com/octocat/hello-world
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name
GITHUB_WORKFLOW_ID=deploy.yml

# GitHub Personal Access Token (classic with 'repo' scope or fine-grained with Actions + Contents read/write)
# Required for triggering workflow_dispatch and querying private repos or higher API rate limits.
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Admin Secret Key for API endpoint protection
# Required by POST /api/deploy (passed via x-admin-secret header)
ADMIN_SECRET=super_secret_admin_token_change_me

# CORS Configuration
# Set to your deployed Render Frontend URL in production, or comma-separated list of allowed origins.
FRONTEND_URL=http://localhost:5173

# Live Deployed Application URL (shown in the dashboard project view)
# e.g. https://your-app.onrender.com
LIVE_APP_URL=https://your-frontend-app.onrender.com
